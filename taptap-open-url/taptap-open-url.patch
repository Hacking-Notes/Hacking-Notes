+    private fun showUrlInputDialog(action: TapTapActionDirectory) {
+        val padding = resources.getDimensionPixelSize(R.dimen.margin_16)
+        val input = EditText(requireContext()).apply {
+            inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_URI
+            hint = getString(R.string.action_open_url_dialog_hint)
+            isSingleLine = true
+        }
+        val container = FrameLayout(requireContext()).apply {
+            setPadding(padding, padding / 2, padding, 0)
+            addView(input)
+        }
+        MaterialAlertDialogBuilder(requireContext())
+            .setTitle(R.string.action_open_url_dialog_title)
+            .setView(container)
+            .setPositiveButton(android.R.string.ok) { _, _ ->
+                val url = OpenUrlAction.normaliseUrl(input.text.toString())
+                whenResumed {
+                    handleAction(action, url, isReturningData = true)
+                }
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
